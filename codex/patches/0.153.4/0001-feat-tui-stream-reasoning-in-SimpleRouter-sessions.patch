@@ -0,0 +1,146 @@
+//! SimpleRouter-scoped live reasoning preview state.
+
+use super::*;
+
+const SIMPLEROUTER_MODEL_PROVIDER_ID: &str = "simplerouter_session";
+const REASONING_STREAM_FRAME_INTERVAL: Duration = Duration::from_millis(60);
+
+pub(super) fn is_simplerouter_provider_id(provider_id: &str) -> bool {
+    provider_id == SIMPLEROUTER_MODEL_PROVIDER_ID
+}
+
+impl ChatWidget {
+    pub(super) fn is_simplerouter_session(&self) -> bool {
+        is_simplerouter_provider_id(&self.config.model_provider_id)
+    }
+
+    pub(super) fn toggle_live_reasoning_and_notify(&mut self) {
+        self.set_live_reasoning_and_notify(!self.live_reasoning_enabled);
+    }
+
+    pub(super) fn set_live_reasoning_and_notify(&mut self, enabled: bool) {
+        self.live_reasoning_enabled = enabled;
+        if !enabled {
+            self.clear_live_reasoning();
+        }
+        self.notify_live_reasoning_state();
+    }
+
+    pub(super) fn notify_live_reasoning_state(&mut self) {
+        let message = if self.live_reasoning_enabled {
+            "Live thinking is on."
+        } else {
+            "Live thinking is off."
+        };
+        self.add_info_message(message.to_string(), /*hint*/ None);
+        if self.live_reasoning_enabled {
+            self.refresh_live_reasoning();
+        }
+    }
+
+    pub(super) fn refresh_live_reasoning(&mut self) {
+        if !self.live_reasoning_enabled || self.config.hide_agent_reasoning {
+            return;
+        }
+
+        if self.live_reasoning_active {
+            if self
+                .transcript
+                .active_cell
+                .as_ref()
+                .is_some_and(|cell| cell.as_any().is::<history_cell::ReasoningSummaryCell>())
+            {
+                return;
+            }
+            self.live_reasoning_active = false;
+        }
+
+        if self.reasoning_summary_parts.is_empty() && self.reasoning_buffer.trim().is_empty() {
+            return;
+        }
+
+        self.flush_active_cell();
+        let mut cell = history_cell::ReasoningSummaryCell::new(
+            String::new(),
+            String::new(),
+            &self.config.cwd,
+            /*transcript_only*/ false,
+        );
+        for (index, part) in self.reasoning_summary_parts.iter().enumerate() {
+            if index > 0 {
+                cell.push_content("\n\n");
+            }
+            cell.push_content(part);
+        }
+        if !self.reasoning_summary_parts.is_empty() && !self.reasoning_buffer.is_empty() {
+            cell.push_content("\n\n");
+        }
+        cell.push_content(&self.reasoning_buffer);
+        if cell.is_empty() {
+            return;
+        }
+
+        self.live_reasoning_active = true;
+        self.transcript.active_cell = Some(Box::new(cell));
+        self.bump_active_cell_revision();
+        self.schedule_live_reasoning_redraw();
+    }
+
+    pub(super) fn append_live_reasoning_delta(&mut self, delta: &str) {
+        if !self.live_reasoning_enabled || self.config.hide_agent_reasoning {
+            return;
+        }
+
+        if self.live_reasoning_active
+            && let Some(cell) = self.transcript.active_cell.as_mut().and_then(|cell| {
+                cell.as_any_mut()
+                    .downcast_mut::<history_cell::ReasoningSummaryCell>()
+            })
+        {
+            cell.push_content(delta);
+            self.bump_active_cell_revision();
+            self.schedule_live_reasoning_redraw();
+            return;
+        }
+
+        self.refresh_live_reasoning();
+    }
+
+    pub(super) fn append_live_reasoning_section_break(&mut self) {
+        if !self.live_reasoning_enabled || self.config.hide_agent_reasoning {
+            return;
+        }
+        if self.live_reasoning_active
+            && let Some(cell) = self.transcript.active_cell.as_mut().and_then(|cell| {
+                cell.as_any_mut()
+                    .downcast_mut::<history_cell::ReasoningSummaryCell>()
+            })
+        {
+            cell.push_content("\n\n");
+            self.bump_active_cell_revision();
+            self.schedule_live_reasoning_redraw();
+        }
+    }
+
+    pub(super) fn clear_live_reasoning(&mut self) {
+        if self.live_reasoning_active {
+            self.transcript.active_cell = None;
+            self.bump_active_cell_revision();
+        }
+        self.live_reasoning_active = false;
+        self.reasoning_redraw_deadline = None;
+    }
+
+    fn schedule_live_reasoning_redraw(&mut self) {
+        let now = Instant::now();
+        if let Some(deadline) = self.reasoning_redraw_deadline
+            && now < deadline
+        {
+            self.frame_requester
+                .schedule_frame_in(deadline.saturating_duration_since(now));
+            return;
+        }
+        self.frame_requester.schedule_frame();
+        self.reasoning_redraw_deadline = Some(now + REASONING_STREAM_FRAME_INTERVAL);
+    }
+}
