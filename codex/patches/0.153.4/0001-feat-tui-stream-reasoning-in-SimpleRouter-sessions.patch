diff --git a/codex-rs/tui/src/chatwidget/tests/live_reasoning.rs b/codex-rs/tui/src/chatwidget/tests/live_reasoning.rs
new file mode 100644
index 00000000..6cbd75af
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/tests/live_reasoning.rs
@@ -0,0 +1,125 @@
+use super::*;
+use crate::history_cell::ReasoningSummaryCell;
+
+const SIMPLEROUTER_PROVIDER: &str = "simplerouter_session";
+
+fn live_reasoning_text(chat: &ChatWidget) -> Option<String> {
+    chat.transcript
+        .active_cell
+        .as_ref()
+        .and_then(|cell| cell.as_any().downcast_ref::<ReasoningSummaryCell>())
+        .map(|cell| lines_to_single_string(&cell.display_lines(/*width*/ 80)))
+}
+
+fn render_chatwidget(chat: &mut ChatWidget, width: u16) -> String {
+    let height = chat.desired_height(width);
+    let mut terminal = ratatui::Terminal::new(ratatui::backend::TestBackend::new(width, height))
+        .expect("create terminal");
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("draw chat widget");
+    normalized_backend_snapshot(terminal.backend())
+}
+
+#[tokio::test]
+async fn simplerouter_streams_reasoning_live_by_default() {
+    let (mut chat, mut rx, _op_rx) =
+        make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    assert!(chat.is_simplerouter_session());
+    assert!(chat.live_reasoning_enabled);
+
+    handle_agent_reasoning_delta(&mut chat, "First chunk.");
+    let first_live = live_reasoning_text(&chat).expect("first live reasoning cell");
+    assert!(first_live.contains("First chunk."));
+    assert!(drain_insert_history(&mut rx).is_empty());
+
+    handle_agent_reasoning_delta(&mut chat, " Second step.");
+    let combined_live = live_reasoning_text(&chat).expect("updated live reasoning cell");
+    assert!(combined_live.contains("First chunk."));
+    assert!(combined_live.contains("Second step."));
+    assert!(
+        combined_live.find("First chunk.").expect("first chunk")
+            < combined_live.find("Second step.").expect("second chunk")
+    );
+
+    assert_chatwidget_snapshot!(
+        "simplerouter_live_reasoning_stream",
+        render_chatwidget(&mut chat, /*width*/ 80)
+    );
+
+    handle_agent_reasoning_final(&mut chat);
+    let mut final_reasoning = None;
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event
+            && let Some(reasoning) = cell.as_any().downcast_ref::<ReasoningSummaryCell>()
+        {
+            final_reasoning = Some(lines_to_single_string(
+                &reasoning.transcript_lines(/*width*/ 80),
+            ));
+        }
+    }
+    assert_eq!(
+        final_reasoning.expect("final reasoning history").trim(),
+        combined_live.trim()
+    );
+    assert!(chat.transcript.active_cell.is_none());
+}
+
+#[tokio::test]
+async fn live_reasoning_preview_is_ephemeral_across_active_cell_flushes() {
+    let (mut chat, mut rx, _op_rx) =
+        make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+
+    handle_agent_reasoning_delta(&mut chat, "Before tool.");
+    chat.flush_active_cell();
+    assert!(chat.transcript.active_cell.is_none());
+    assert!(drain_insert_history(&mut rx).is_empty());
+
+    handle_agent_reasoning_delta(&mut chat, " After tool.");
+    let rebuilt = live_reasoning_text(&chat).expect("rebuilt live reasoning cell");
+    assert!(rebuilt.contains("Before tool."));
+    assert!(rebuilt.contains("After tool."));
+}
+
+#[tokio::test]
+async fn thinking_command_toggles_and_restores_the_live_preview() {
+    let (mut chat, mut rx, _op_rx) =
+        make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    handle_agent_reasoning_delta(&mut chat, "Visible thought.");
+    assert!(live_reasoning_text(&chat).is_some());
+
+    chat.dispatch_command_with_args(SlashCommand::Thinking, "off".to_string(), Vec::new());
+    assert!(!chat.live_reasoning_enabled);
+    assert!(chat.transcript.active_cell.is_none());
+
+    chat.dispatch_command(SlashCommand::Thinking);
+    assert!(chat.live_reasoning_enabled);
+    assert!(
+        live_reasoning_text(&chat)
+            .expect("restored live reasoning")
+            .contains("Visible thought.")
+    );
+
+    chat.dispatch_command_with_args(SlashCommand::Thinking, "status".to_string(), Vec::new());
+    let notices = drain_insert_history(&mut rx)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(notices.contains("Live thinking is off."));
+    assert!(notices.matches("Live thinking is on.").count() >= 2);
+}
+
+#[tokio::test]
+async fn live_reasoning_is_disabled_outside_simplerouter_and_respects_hide_flag() {
+    let (mut regular_chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    assert!(!regular_chat.live_reasoning_enabled);
+    handle_agent_reasoning_delta(&mut regular_chat, "Buffered thought.");
+    assert!(live_reasoning_text(&regular_chat).is_none());
+
+    let (mut hidden_chat, _rx, _op_rx) =
+        make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    hidden_chat.config.hide_agent_reasoning = true;
+    handle_agent_reasoning_delta(&mut hidden_chat, "Hidden thought.");
+    assert!(live_reasoning_text(&hidden_chat).is_none());
+}
