+            }
+            "google/gemini-3.8-flash" | "gemini-3.8-flash" => Some(26_560.0 / 6_963.0),
+            "meta/muse-spark-1.3" | "muse-spark-1.3" => Some(13_313.0 / 3_714.0),
+            "moonshotai/kimi-k3" | "kimi-k3" => Some(32_924.0 / 8_428.0),
+            "openai/gpt-5.6-luna" | "gpt-5.6-luna" => Some(10_093.0 / 2_553.0),
+            "openai/gpt-5.6-sol" | "gpt-5.6-sol" => Some(21_672.0 / 4_967.0),
+            "qwen/qwen3.8-27b" | "qwen3.8-27b" => Some(6_806.0 / 1_907.0),
+            "tencent/hy3" | "hy3" => Some(5_835.0 / 1_639.0),
+            "x-ai/grok-4.6" | "grok-4.6" => Some(13_097.0 / 3_407.0),
+            "z-ai/glm-5.3" | "glm-5.3" => Some(27_173.0 / 7_087.0),
+            "z-ai/glm-5.3-flash" | "glm-5.3-flash" => Some(11_077.0 / 2_971.0),
+            _ => None,
+        };
+        Self {
+            initial_chars_per_token,
+            ..Self::default()
+        }
+    }
