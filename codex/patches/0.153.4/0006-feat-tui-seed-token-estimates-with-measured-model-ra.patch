+#[test]
+fn model_starting_defaults_recognize_nitro_and_bare_ids() {
+    let qualified = TokenCalibration::for_model("openai/gpt-5.6-sol");
+    assert!(qualified.initial_chars_per_token.is_some());
+    assert!(!qualified.text.is_calibrated());
+    for alias in [
+        "gpt-5.6-sol",
+        "gpt-5.6-sol:nitro",
+        "openai/gpt-5.6-sol:nitro",
+    ] {
+        assert_eq!(
+            TokenCalibration::for_model(alias).initial_chars_per_token,
+            qualified.initial_chars_per_token
+        );
+    }
+    for unmeasured in [
+        "openai/gpt-5.6-sol-pro",
+        "custom/gpt-5.6-sol",
+        "tencent/hy4-preview",
+    ] {
+        assert_eq!(
+            TokenCalibration::for_model(unmeasured).initial_chars_per_token,
+            None
+        );
+    }
+}
+
+#[test]
+fn model_starting_defaults_give_way_to_continued_calibration() {
+    let started_at = Instant::now();
+    let model = "openai/gpt-5.6-sol:nitro";
+    let mut tracker = GenerationRateTracker::new(true);
+    let mut suffixes = Vec::new();
+
+    for (index, chars) in [600, 900, 600].into_iter().enumerate() {
+        let start = started_at + Duration::from_secs(index as u64 * 10);
+        tracker.begin_turn(model);
+        tracker.sampling_started(/*active_api_duration_ms*/ 0, start);
+        tracker.observe_delta(RawResponseOutputKind::Text, chars / 2, start);
+        tracker.observe_delta(
+            RawResponseOutputKind::Text,
+            chars / 2,
+            start + Duration::from_secs(1),
+        );
+        suffixes.push(
+            tracker
+                .status_suffix(start + Duration::from_secs(1))
+                .unwrap(),
+        );
+        tracker.response_completed(Some(200), Some(0));
+        tracker.finish_turn(start + Duration::from_secs(1));
+
+        if index == 0 {
+            // No synthetic sample weight: the first response establishes 3.0.
+            assert_eq!(tracker.calibration().text.chars_per_token(), Some(3.0));
+        } else if index == 1 {
+            // Old counts halve before adding the next response: 1200 / 300.
+            assert_eq!(tracker.calibration().text.chars_per_token(), Some(4.0));
+        }
+    }
+
+    insta::assert_snapshot!(
+        "model_starting_defaults_and_continued_calibration",
+        suffixes.join("\n")
+    );
+
+    let learned = tracker.calibration().text.chars_per_token();
+    tracker.begin_turn("anthropic/claude-opus-5");
+    assert!(!tracker.calibration().text.is_calibrated());
+    tracker.begin_turn(model);
+    assert_eq!(tracker.calibration().text.chars_per_token(), learned);
+}
