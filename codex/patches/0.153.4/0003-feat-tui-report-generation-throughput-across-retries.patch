diff --git a/codex-rs/tui/src/history_cell/messages.rs b/codex-rs/tui/src/history_cell/messages.rs
index 3f77534d..bccd216e 100644
--- a/codex-rs/tui/src/history_cell/messages.rs
+++ b/codex-rs/tui/src/history_cell/messages.rs
@@ -690,6 +690,29 @@ pub(crate) fn new_reasoning_summary_block(
 }
 
 /// Split structured reasoning-summary parts into the status header and renderable content.
+/// Create the reasoning history cell for sessions that keep thinking visible in the main
+/// viewport. The cell mirrors the live preview: scrollback renders the trailing `tail_rows`
+/// rows while the transcript keeps the full text. Falls back to the standard summary block
+/// when there is no renderable content.
+pub(crate) fn new_reasoning_summary_tail_block(
+    reasoning_parts: Vec<String>,
+    cwd: &Path,
+    tail_rows: usize,
+) -> Box<dyn HistoryCell> {
+    let mut cell =
+        ReasoningSummaryCell::new_live_preview(String::new(), String::new(), cwd, tail_rows);
+    for (index, part) in reasoning_parts.iter().enumerate() {
+        if index > 0 {
+            cell.push_content("\n\n");
+        }
+        cell.push_content(part);
+    }
+    if cell.is_empty() {
+        return new_reasoning_summary_block(reasoning_parts, cwd);
+    }
+    Box::new(cell)
+}
+
 pub(crate) fn split_reasoning_summary_parts(reasoning_parts: &[String]) -> (String, String) {
     let mut leading_empty_part_header = None;
     let mut content_parts = Vec::with_capacity(reasoning_parts.len());
