+#[tokio::test]
+async fn final_reasoning_stays_visible_in_scrollback_with_tail_cap() {
+    let (mut chat, mut rx, _op_rx) =
+        make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    let reasoning = (0..40)
+        .map(|i| format!("thought-{i}\n"))
+        .collect::<String>();
+
+    handle_agent_reasoning_delta(&mut chat, &reasoning);
+    handle_agent_reasoning_final(&mut chat);
+    assert!(chat.transcript.active_cell.is_none());
+
+    let mut final_cell = None;
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event
+            && cell.as_any().is::<ReasoningSummaryCell>()
+        {
+            final_cell = Some(cell);
+        }
+    }
+    let final_cell = final_cell.expect("final reasoning history cell");
+    let reasoning_cell = final_cell
+        .as_any()
+        .downcast_ref::<ReasoningSummaryCell>()
+        .expect("reasoning summary cell");
+    let display_lines = reasoning_cell.display_lines(/*width*/ 80);
+    let display = lines_to_single_string(&display_lines);
+    let transcript = lines_to_single_string(&reasoning_cell.transcript_lines(/*width*/ 80));
+
+    assert!(!display_lines.is_empty());
+    assert!(display_lines.len() <= 20);
+    assert!(display.contains("earlier thinking"));
+    assert!(!display.contains("thought-0"));
+    assert!(display.contains("thought-39"));
+    assert!(transcript.contains("thought-0"));
+    assert!(transcript.contains("thought-39"));
 }
 
