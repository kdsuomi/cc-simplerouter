+#[derive(Debug, Default)]
+struct ResponseGenerationMetrics {
+    first_output_at: Option<Instant>,
+    last_output_at: Option<Instant>,
+    streamed_output_chars: u64,
+}
+
+impl ResponseGenerationMetrics {
+    fn observe(&mut self, event: &ResponseEvent, uses_sequential_reasoning_summaries: bool) {
+        let output_chars = match event {
+            ResponseEvent::OutputTextDelta(delta)
+            | ResponseEvent::ToolCallInputDelta { delta, .. }
+            | ResponseEvent::ReasoningContentDelta { delta, .. } => delta.chars().count(),
+            ResponseEvent::ReasoningSummaryDelta { delta, .. }
+                if !uses_sequential_reasoning_summaries =>
+            {
+                delta.chars().count()
+            }
+            ResponseEvent::ReasoningSummaryDone { text, .. }
+                if uses_sequential_reasoning_summaries =>
+            {
+                text.chars().count()
+            }
+            _ => 0,
+        };
+        if output_chars == 0 {
+            return;
+        }
+        let now = Instant::now();
+        self.first_output_at.get_or_insert(now);
+        self.last_output_at = Some(now);
+        self.streamed_output_chars = self
+            .streamed_output_chars
+            .saturating_add(output_chars as u64);
+    }
+
+    fn generation_duration_ms(&self) -> Option<i64> {
+        let duration = self
+            .last_output_at?
+            .saturating_duration_since(self.first_output_at?);
+        if duration.is_zero() {
+            return None;
+        }
+        Some(i64::try_from(duration.as_millis()).unwrap_or(i64::MAX))
+    }
+
+    fn streamed_output_chars(&self) -> i64 {
+        i64::try_from(self.streamed_output_chars).unwrap_or(i64::MAX)
+    }
+}
