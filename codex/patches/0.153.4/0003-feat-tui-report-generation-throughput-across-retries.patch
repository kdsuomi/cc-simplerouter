+
+#[test]
+fn launcher_opt_in_enables_standard_provider_sessions() {
+    assert!(token_rate_enabled("openai", Some("1"), None));
+    assert!(!token_rate_enabled("openai", None, None));
+    assert!(!token_rate_enabled("openai", Some("1"), Some("1")));
+}
+
+#[test]
+fn turn_average_uses_cumulative_api_time_and_persists_until_the_next_turn() {
+    let started_at = Instant::now();
+    let mut tracker = GenerationRateTracker::new(true);
+    tracker.begin_turn();
+
+    tracker.sampling_started(/*active_api_duration_ms*/ 0, started_at);
+    tracker.observe_delta(&"a".repeat(40), started_at + Duration::from_secs(1));
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(2)),
+        Some("5.0 tok/s".to_string())
+    );
+    tracker.response_completed(Some(100));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 20_000,
+        /*generation_duration_ms*/ Some(2_000),
+        /*streamed_output_chars*/ 40,
+        started_at + Duration::from_secs(20),
+    );
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(100)),
+        Some("5.0 tok/s".to_string())
+    );
+
+    tracker.sampling_started(
+        /*active_api_duration_ms*/ 20_000,
+        started_at + Duration::from_secs(100),
+    );
+    tracker.observe_delta(
+        &"b".repeat(400),
+        started_at + Duration::from_millis(100_500),
+    );
+    tracker.response_completed(Some(300));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 80_000,
+        /*generation_duration_ms*/ Some(4_000),
+        /*streamed_output_chars*/ 400,
+        started_at + Duration::from_secs(180),
+    );
+    tracker.finish_turn(started_at + Duration::from_secs(180));
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(1_000)),
+        Some("5.0 tok/s".to_string())
+    );
+
+    tracker.begin_turn();
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(2_000)),
+        None
+    );
+}
+
+#[test]
+fn exact_completion_usage_replaces_the_streaming_estimate() {
+    let started_at = Instant::now();
+    let mut tracker = GenerationRateTracker::new(true);
+    tracker.begin_turn();
+    tracker.sampling_started(/*active_api_duration_ms*/ 0, started_at);
+    tracker.observe_delta(&"x".repeat(400), started_at + Duration::from_secs(1));
+    tracker.response_completed(Some(40));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 10_000,
+        /*generation_duration_ms*/ None,
+        /*streamed_output_chars*/ 400,
+        started_at + Duration::from_secs(10),
+    );
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(20)),
+        Some("4.0 tok/s".to_string())
+    );
+}
+
+#[test]
+fn sampling_time_includes_stream_delivery_stalls() {
+    let started_at = Instant::now();
+    let mut tracker = GenerationRateTracker::new(true);
+    tracker.begin_turn();
+    tracker.sampling_started(/*active_api_duration_ms*/ 0, started_at);
+    tracker.observe_delta(&"x".repeat(400), started_at + Duration::from_secs(1));
+    tracker.observe_delta(&"y".repeat(400), started_at + Duration::from_secs(3));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 100_000,
+        /*generation_duration_ms*/ Some(2_000),
+        /*streamed_output_chars*/ 800,
+        started_at + Duration::from_secs(100),
+    );
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(200)),
+        Some("2.0 tok/s".to_string())
+    );
+}
+
+#[test]
+fn successful_retry_recalibrates_an_incomplete_attempt() {
+    let started_at = Instant::now();
+    let mut tracker = GenerationRateTracker::new(true);
+    tracker.begin_turn();
+
+    tracker.sampling_started(/*active_api_duration_ms*/ 0, started_at);
+    tracker.observe_delta(&"x".repeat(200), started_at + Duration::from_secs(1));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 10_000,
+        /*generation_duration_ms*/ Some(2_000),
+        /*streamed_output_chars*/ 200,
+        started_at + Duration::from_secs(10),
+    );
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(20)),
+        Some("5.0 tok/s".to_string())
+    );
+
+    tracker.sampling_started(
+        /*active_api_duration_ms*/ 10_000,
+        started_at + Duration::from_secs(100),
+    );
+    tracker.observe_delta(
+        &"y".repeat(100),
+        started_at + Duration::from_millis(100_500),
+    );
+    tracker.response_completed(Some(50));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 20_000,
+        /*generation_duration_ms*/ Some(1_000),
+        /*streamed_output_chars*/ 100,
+        started_at + Duration::from_secs(110),
+    );
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(200)),
+        Some("7.5 tok/s".to_string())
+    );
+}
