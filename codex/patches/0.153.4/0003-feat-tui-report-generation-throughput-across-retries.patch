index 351d1e6c..c9f3093f 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -566,9 +566,12 @@ ignored = [
 ]
 
 [profile.dev]
-# Keep line tables/backtraces while avoiding expensive full variable debug info
-# across local dev builds.
-debug = "limited"
+# Optimize for the shortest local edit/build cycle.
+debug = "none"
+
+[profile.test]
+# Tests dominate local iteration in this worktree, so omit debug info entirely.
+debug = "none"
 
 [profile.dev-small]
 inherits = "dev"
@@ -577,15 +580,14 @@ debug = "none"
 strip = "symbols"
 
 [profile.release]
-lto = "thin"
-debug = "line-tables-only"
+lto = false
+debug = "none"
 split-debuginfo = "off"
-# Keep release binaries symbolicateable until packaging has archived the
-# sidecar symbols and stripped the binaries.
-strip = false
+incremental = true
+strip = "symbols"
 
-# Balance parallel release code generation against binary size.
-codegen-units = 4
+# Favor compile-time parallelism over maximum runtime optimization.
+codegen-units = 16
 
 [profile.profiling]
 inherits = "release"
