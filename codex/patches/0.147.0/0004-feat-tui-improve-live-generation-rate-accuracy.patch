+#[derive(Clone, Copy, Debug, Default)]
+struct CalibrationBucket {
+    weighted_chars: f64,
+    weighted_tokens: f64,
+}
+
+impl CalibrationBucket {
+    fn observe(&mut self, chars: f64, tokens: f64) {
+        if chars <= 0.0 || tokens <= 0.0 || !chars.is_finite() || !tokens.is_finite() {
+            return;
+        }
+        self.weighted_chars = self.weighted_chars * CALIBRATION_HISTORY_WEIGHT + chars;
+        self.weighted_tokens = self.weighted_tokens * CALIBRATION_HISTORY_WEIGHT + tokens;
+    }
+
+    fn chars_per_token(self) -> f64 {
+        if self.weighted_chars > 0.0 && self.weighted_tokens > 0.0 {
+            (self.weighted_chars / self.weighted_tokens)
+                .clamp(MIN_ESTIMATED_CHARS_PER_TOKEN, MAX_ESTIMATED_CHARS_PER_TOKEN)
+        } else {
+            DEFAULT_ESTIMATED_CHARS_PER_TOKEN
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct TokenCalibration {
+    content: CalibrationBucket,
+    reasoning_text: CalibrationBucket,
+}
+
+impl TokenCalibration {
+    fn observe_exact(&mut self, chars: OutputChars, usage: ExactUsage) {
+        let content_tokens = (usage.output_tokens - usage.reasoning_output_tokens).max(0.0);
+        self.content.observe(chars.content() as f64, content_tokens);
+
+        // Reasoning summaries are not a reliable representation of hidden
+        // reasoning-token volume. Only calibrate that bucket when raw reasoning
+        // text was actually streamed.
+        self.reasoning_text
+            .observe(chars.reasoning_text as f64, usage.reasoning_output_tokens);
+    }
+
+    fn estimate_tokens(self, chars: OutputChars) -> f64 {
+        let content_tokens = chars.content() as f64 / self.content.chars_per_token();
+        let reasoning_chars = chars.reasoning_for_estimate() as f64;
+        let reasoning_chars_per_token = if chars.reasoning_text > 0 {
+            self.reasoning_text.chars_per_token()
+        } else {
+            // A summary-only stream is visible generated text, not a direct
+            // measurement of hidden reasoning. Estimate only its visible token
+            // count and leave the result explicitly approximate until usage
+            // arrives.
+            self.content.chars_per_token()
+        };
+        content_tokens + reasoning_chars / reasoning_chars_per_token
+    }
 }
 
