+        let mut counts = Self {
+            text: nonnegative_u64(text),
+            tool_arguments: nonnegative_u64(tool_arguments),
+            reasoning_summary: nonnegative_u64(reasoning_summary),
+            reasoning_text: nonnegative_u64(reasoning_text),
+        };
