From e06f9a31479f467827d74a42b668ff83e92ffe1b Mon Sep 17 00:00:00 2001
From: kdsuomi <kyle@kyles-air.myfiosgateway.com>
Date: Fri, 28 Aug 2026 22:51:32 -0400
Subject: [PATCH 5/5] fix(tui): keep live stream metrics accurate

---
 codex-rs/core/src/session/turn.rs             | 18 ++++++++++---
 codex-rs/core/src/session/turn_tests.rs       |  5 ++--
 .../src/chatwidget/generation_rate_tests.rs   | 25 +++++++++++++++++++
 3 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/codex-rs/core/src/session/turn.rs b/codex-rs/core/src/session/turn.rs
index ca72aba9..8f1ed321 100644
--- a/codex-rs/core/src/session/turn.rs
+++ b/codex-rs/core/src/session/turn.rs
@@ -2179,10 +2179,20 @@ impl ResponseGenerationMetrics {
             ResponseEvent::ReasoningSummaryDone { text, .. }
                 if uses_sequential_reasoning_summaries =>
             {
-                (
-                    RawResponseOutputKind::ReasoningSummary,
-                    text.chars().count(),
-                )
+                // A terminal summary is one non-incremental payload. Counting
+                // it as a live delta would synthesize one inter-token interval
+                // per token even though the client received it in one event.
+                let summary_chars = text.chars().count();
+                if summary_chars == 0 {
+                    return None;
+                }
+                self.streamed_output_chars = self
+                    .streamed_output_chars
+                    .saturating_add(summary_chars as u64);
+                self.streamed_reasoning_summary_chars = self
+                    .streamed_reasoning_summary_chars
+                    .saturating_add(summary_chars as u64);
+                return None;
             }
             _ => return None,
         };
diff --git a/codex-rs/core/src/session/turn_tests.rs b/codex-rs/core/src/session/turn_tests.rs
index ca38acba..7d21b00c 100644
--- a/codex-rs/core/src/session/turn_tests.rs
+++ b/codex-rs/core/src/session/turn_tests.rs
@@ -134,11 +134,10 @@ fn sequential_reasoning_metrics_count_done_instead_of_deltas() {
             },
             true,
         )
-        .expect("sequential reasoning summary done");
+        .expect_none("terminal summary must not emit a live delta");
 
-    assert_eq!(done.output_kind, RawResponseOutputKind::ReasoningSummary);
-    assert_eq!(done.chars, 7);
     assert_eq!(metrics.streamed_output_chars(), 7);
+    assert_eq!(metrics.streamed_reasoning_summary_chars(), 7);
 }
 
 #[tokio::test]
diff --git a/codex-rs/tui/src/chatwidget/generation_rate_tests.rs b/codex-rs/tui/src/chatwidget/generation_rate_tests.rs
index 6f057a4c..307f802f 100644
--- a/codex-rs/tui/src/chatwidget/generation_rate_tests.rs
+++ b/codex-rs/tui/src/chatwidget/generation_rate_tests.rs
@@ -80,6 +80,31 @@ fn exact_usage_reports_stream_and_api_rates_with_distinct_denominators() {
     );
 }
 
+#[test]
+fn terminal_summary_usage_does_not_inflate_the_live_stream_rate() {
+    let started_at = Instant::now();
+    let mut tracker = GenerationRateTracker::new(true);
+    tracker.begin_turn();
+    tracker.sampling_started(/*active_api_duration_ms*/ 0, started_at);
+    tracker.response_completed(Some(3_000), Some(2_900));
+    tracker.sampling_stopped(
+        /*active_api_duration_ms*/ 10_000,
+        /*generation_duration_ms*/ Some(50),
+        /*streamed_output_chars*/ 12_000,
+        /*streamed_text_chars*/ 0,
+        /*streamed_tool_argument_chars*/ 0,
+        /*streamed_reasoning_summary_chars*/ 12_000,
+        /*streamed_reasoning_text_chars*/ 0,
+        started_at + Duration::from_millis(50),
+    );
+    tracker.finish_turn(started_at + Duration::from_millis(50));
+
+    assert_eq!(
+        tracker.status_suffix(started_at + Duration::from_secs(1)),
+        Some("API 300.0 tok/s".to_string())
+    );
+}
+
 #[test]
 fn tool_argument_deltas_contribute_to_the_live_rate() {
     let started_at = Instant::now();
