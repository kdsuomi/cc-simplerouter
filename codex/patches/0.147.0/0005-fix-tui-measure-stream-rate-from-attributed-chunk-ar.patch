+    /// Client-observed stream rate over the rolling window.
+    ///
+    /// The denominator is anchored at the start of the earliest surviving
+    /// chunk's interval — the full interval, even when it began before the
+    /// window span, so a blob that arrived after a long generation gap is
+    /// averaged over that gap rather than spiking. The denominator extends to
+    /// `now`, so an ongoing stall keeps widening it: the rate decays smoothly
+    /// toward zero and disappears once every chunk has aged out.
+    fn live_stream_rate(&self, now: Instant) -> Option<DisplayRate> {
+        let mut tokens = 0.0;
+        let mut anchor: Option<Instant> = None;
+        for chunk in &self.stream_window {
+            if now.saturating_duration_since(chunk.arrived) > STREAM_WINDOW {
+                continue;
+            }
+            if anchor.is_none() {
+                anchor = Some(
+                    chunk
+                        .arrived
+                        .checked_sub(chunk.interval)
+                        .unwrap_or(chunk.arrived),
+                );
+            }
+            tokens += chunk.tokens;
+        }
+        let elapsed = now.saturating_duration_since(anchor?);
+        if tokens < MIN_STREAM_WINDOW_TOKENS || elapsed < MIN_STREAM_WINDOW_TIME {
+            return None;
+        }
+        rate(tokens, elapsed).map(|tokens_per_second| DisplayRate {
+            tokens_per_second,
+            estimated: true,
+        })
+    }
