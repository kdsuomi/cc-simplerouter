+#[tokio::test]
+async fn live_reasoning_preview_is_bounded_but_transcript_keeps_every_line() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    let reasoning = (0..20)
+        .map(|i| format!("thought-{i}\n"))
+        .collect::<String>();
+
+    handle_agent_reasoning_delta(&mut chat, &reasoning);
+
+    let cell = chat
+        .transcript
+        .active_cell
+        .as_ref()
+        .and_then(|cell| cell.as_any().downcast_ref::<ReasoningSummaryCell>())
+        .expect("live reasoning cell");
+    let display_lines = cell.display_lines(/*width*/ 80);
+    let display = lines_to_single_string(&display_lines);
+    let transcript = lines_to_single_string(&cell.transcript_lines(/*width*/ 80));
+
+    assert!(display_lines.len() <= 12);
+    assert!(display.contains("earlier thinking"));
+    assert!(!display.contains("thought-0"));
+    assert!(display.contains("thought-19"));
+    assert!(transcript.contains("thought-0"));
+    assert!(transcript.contains("thought-19"));
+}
