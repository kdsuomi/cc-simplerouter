+    fn max_scroll_offset(&self) -> usize {
+        self.last_rendered_height
+            .unwrap_or_default()
+            .saturating_sub(self.last_content_height.unwrap_or_default())
+    }
+
+    fn effective_scroll_offset(&self) -> usize {
+        if self.follow_tail {
+            self.max_scroll_offset()
+        } else {
+            self.scroll_offset.min(self.max_scroll_offset())
+        }
+    }
+
+    fn scroll_up_rows(&mut self, rows: usize) {
+        self.scroll_offset = self.effective_scroll_offset().saturating_sub(rows);
+        self.follow_tail = false;
+    }
+
+    fn scroll_down_rows(&mut self, rows: usize) {
+        let max_scroll = self.max_scroll_offset();
+        let next = self
+            .effective_scroll_offset()
+            .saturating_add(rows)
+            .min(max_scroll);
+        self.scroll_offset = next;
+        self.follow_tail = next >= max_scroll;
+    }
+
+    fn set_follow_tail(&mut self, follow_tail: bool) {
+        self.follow_tail = follow_tail;
+        if follow_tail {
+            self.scroll_offset = self.max_scroll_offset();
+        }
+    }
