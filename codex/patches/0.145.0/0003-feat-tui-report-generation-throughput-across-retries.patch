+use super::*;
+use codex_app_server_protocol::RawResponseCompletedNotification;
+use codex_app_server_protocol::RawResponseStartedNotification;
+use codex_app_server_protocol::RawResponseStoppedNotification;
+use codex_app_server_protocol::TokenUsageBreakdown;
+
+const SIMPLEROUTER_PROVIDER: &str = "simplerouter_session";
+
+fn render_chatwidget(chat: &mut ChatWidget, width: u16) -> String {
+    let height = chat.desired_height(width);
+    let mut terminal = ratatui::Terminal::new(ratatui::backend::TestBackend::new(width, height))
+        .expect("create terminal");
+    terminal.set_viewport_area(Rect::new(/*x*/ 0, /*y*/ 0, width, height));
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("draw chat widget");
+    normalized_backend_snapshot(terminal.backend())
+}
+
+#[tokio::test]
+async fn completed_turn_keeps_generation_rate_status_suffix() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual_with_provider(SIMPLEROUTER_PROVIDER).await;
+    chat.config.tui_status_line = Some(Vec::new());
+    chat.generation_rate = GenerationRateTracker::new(true);
+    chat.on_task_started();
+
+    chat.handle_server_notification(
+        ServerNotification::RawResponseStarted(RawResponseStartedNotification {
+            thread_id: "thread-1".to_string(),
+            turn_id: "turn-1".to_string(),
+            active_api_duration_ms: 0,
+        }),
+        /*replay_kind*/ None,
+    );
+    chat.handle_server_notification(
+        ServerNotification::RawResponseCompleted(RawResponseCompletedNotification {
+            thread_id: "thread-1".to_string(),
+            turn_id: "turn-1".to_string(),
+            response_id: "response-1".to_string(),
+            usage: Some(TokenUsageBreakdown {
+                total_tokens: 150,
+                input_tokens: 30,
+                cached_input_tokens: 0,
+                cache_write_input_tokens: 0,
+                output_tokens: 120,
+                reasoning_output_tokens: 80,
+            }),
+        }),
+        /*replay_kind*/ None,
+    );
+    chat.handle_server_notification(
+        ServerNotification::RawResponseStopped(RawResponseStoppedNotification {
+            thread_id: "thread-1".to_string(),
+            turn_id: "turn-1".to_string(),
+            active_api_duration_ms: 20_000,
+            generation_duration_ms: Some(2_000),
+            streamed_output_chars: 240,
+        }),
+        /*replay_kind*/ None,
+    );
+    chat.on_task_complete(
+        /*last_agent_message*/ None,
+        /*duration_ms*/ Some(20_000),
+        /*from_replay*/ false,
+    );
+
+    assert_eq!(
+        chat.generation_rate.status_suffix(Instant::now()),
+        Some("6.0 tok/s".to_string())
+    );
+    assert_chatwidget_snapshot!(
+        "simplerouter_completed_turn_generation_rate_suffix",
+        render_chatwidget(&mut chat, /*width*/ 80)
+    );
+}
