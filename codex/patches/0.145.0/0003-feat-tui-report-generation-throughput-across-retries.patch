diff --git a/codex-rs/tui/src/chatwidget/generation_rate.rs b/codex-rs/tui/src/chatwidget/generation_rate.rs
new file mode 100644
index 0000000..915df43
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/generation_rate.rs
@@ -0,0 +1,261 @@
+//! SimpleRouter generation-rate tracking for the status-line suffix.
+//!
+//! Exact native output usage replaces the streaming estimate when a response
+//! completes. The denominator is cumulative API sampling time, including time
+//! to first token and stream delivery, while excluding local tools and idle
+//! time between sampling requests.
+
+use std::time::Duration;
+use std::time::Instant;
+
+use super::ChatWidget;
+use super::live_reasoning::is_simplerouter_provider_id;
+
+const DISABLE_TOKEN_RATE_ENV: &str = "SIMPLEROUTER_DISABLE_TOKEN_RATE";
+const DEFAULT_ESTIMATED_CHARS_PER_TOKEN: f64 = 4.0;
+#[derive(Debug)]
+struct ActiveSampling {
+    sampling_started_at: Instant,
+    active_api_duration_at_start: Duration,
+    observed_output_chars: u64,
+    exact_output_tokens: Option<f64>,
+}
+
+impl ActiveSampling {
+    fn new(active_api_duration_ms: i64, now: Instant) -> Self {
+        Self {
+            sampling_started_at: now,
+            active_api_duration_at_start: Duration::from_millis(
+                active_api_duration_ms.max(0) as u64
+            ),
+            observed_output_chars: 0,
+            exact_output_tokens: None,
+        }
+    }
+
+    fn observe_delta(&mut self, delta: &str, _now: Instant) {
+        let output_chars = delta.chars().count() as u64;
+        if output_chars == 0 {
+            return;
+        }
+        self.observed_output_chars = self.observed_output_chars.saturating_add(output_chars);
+    }
+
+    fn live_api_duration(&self, now: Instant) -> Duration {
+        self.active_api_duration_at_start
+            .saturating_add(now.saturating_duration_since(self.sampling_started_at))
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct GenerationRateTracker {
+    enabled: bool,
+    turn_running: bool,
+    turn_exact_output_tokens: f64,
+    turn_estimated_output_chars: f64,
+    turn_api_duration: Duration,
+    active_sampling: Option<ActiveSampling>,
+    calibration_output_chars: f64,
+    calibration_output_tokens: f64,
+    retained_rate: Option<f64>,
+}
+
+impl GenerationRateTracker {
+    pub(super) fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            turn_running: false,
+            turn_exact_output_tokens: 0.0,
+            turn_estimated_output_chars: 0.0,
+            turn_api_duration: Duration::ZERO,
+            active_sampling: None,
+            calibration_output_chars: 0.0,
+            calibration_output_tokens: 0.0,
+            retained_rate: None,
+        }
+    }
+
+    pub(super) fn begin_turn(&mut self) {
+        if !self.enabled {
+            return;
+        }
+        self.turn_running = true;
+        self.turn_exact_output_tokens = 0.0;
+        self.turn_estimated_output_chars = 0.0;
+        self.turn_api_duration = Duration::ZERO;
+        self.active_sampling = None;
+        self.retained_rate = None;
+    }
+
+    pub(super) fn finish_turn(&mut self, now: Instant) {
+        if !self.enabled {
+            return;
+        }
+        if let Some(active) = self.active_sampling.as_ref() {
+            self.turn_api_duration = active.live_api_duration(now);
+        }
+        self.finalize_active_sampling(/*output_chars*/ None);
+        self.retained_rate = self.turn_rate(now);
+        self.turn_running = false;
+    }
+
+    pub(super) fn sampling_started(&mut self, active_api_duration_ms: i64, now: Instant) {
+        if !self.enabled || !self.turn_running {
+            return;
+        }
+        if let Some(active) = self.active_sampling.as_ref() {
+            self.turn_api_duration = active.live_api_duration(now);
+            self.finalize_active_sampling(/*output_chars*/ None);
+        }
+        self.turn_api_duration = self
+            .turn_api_duration
+            .max(Duration::from_millis(active_api_duration_ms.max(0) as u64));
+        self.active_sampling = Some(ActiveSampling::new(active_api_duration_ms, now));
+    }
+
+    pub(super) fn observe_delta(&mut self, delta: &str, now: Instant) {
+        let Some(active) = self.active_sampling.as_mut() else {
+            return;
+        };
+        active.observe_delta(delta, now);
+    }
+
+    pub(super) fn response_completed(&mut self, output_tokens: Option<i64>) {
+        let Some(active) = self.active_sampling.as_mut() else {
+            return;
+        };
+        if let Some(output_tokens) = output_tokens {
+            active.exact_output_tokens = Some(output_tokens.max(0) as f64);
+        }
+    }
+
+    pub(super) fn sampling_stopped(
+        &mut self,
+        active_api_duration_ms: i64,
+        _generation_duration_ms: Option<i64>,
+        streamed_output_chars: i64,
+        now: Instant,
+    ) {
+        if !self.enabled || !self.turn_running {
+            return;
+        }
+        self.turn_api_duration = self
+            .turn_api_duration
+            .max(Duration::from_millis(active_api_duration_ms.max(0) as u64));
+        let output_chars = u64::try_from(streamed_output_chars).ok();
+        self.finalize_active_sampling(output_chars);
+        self.retained_rate = self.turn_rate(now);
+    }
+
+    pub(super) fn status_suffix(&self, now: Instant) -> Option<String> {
+        let rate = if self.turn_running {
+            self.turn_rate(now).or(self.retained_rate)
+        } else {
+            self.retained_rate
+        }?;
+        if !rate.is_finite() || rate <= 0.0 {
+            return None;
+        }
+        Some(format!("{rate:.1} tok/s"))
+    }
+
+    fn finalize_active_sampling(&mut self, streamed_output_chars: Option<u64>) {
+        let Some(active) = self.active_sampling.take() else {
+            return;
+        };
+        let output_chars = streamed_output_chars
+            .unwrap_or_default()
+            .max(active.observed_output_chars) as f64;
+
+        match active.exact_output_tokens {
+            Some(output_tokens) if output_tokens > 0.0 => {
+                self.turn_exact_output_tokens += output_tokens;
+                if output_chars > 0.0 {
+                    self.calibration_output_chars += output_chars;
+                    self.calibration_output_tokens += output_tokens;
+                }
+            }
+            _ if output_chars > 0.0 => {
+                self.turn_estimated_output_chars += output_chars;
+            }
+            _ => (),
+        }
+    }
+
+    fn turn_rate(&self, now: Instant) -> Option<f64> {
+        let mut output_tokens =
+            self.turn_exact_output_tokens + self.estimated_tokens(self.turn_estimated_output_chars);
+        let mut api_duration = self.turn_api_duration;
+
+        if let Some(active) = self.active_sampling.as_ref() {
+            let active_tokens = active
+                .exact_output_tokens
+                .unwrap_or_else(|| self.estimated_tokens(active.observed_output_chars as f64));
+            output_tokens += active_tokens;
+            api_duration = active.live_api_duration(now);
+        }
+
+        rate(output_tokens, api_duration)
+    }
+
+    fn estimated_tokens(&self, output_chars: f64) -> f64 {
+        output_chars / self.estimated_chars_per_token()
+    }
+
+    fn estimated_chars_per_token(&self) -> f64 {
+        if self.calibration_output_chars > 0.0 && self.calibration_output_tokens > 0.0 {
+            self.calibration_output_chars / self.calibration_output_tokens
+        } else {
+            DEFAULT_ESTIMATED_CHARS_PER_TOKEN
+        }
+    }
+}
+
+pub(super) fn enabled_for_provider(provider_id: &str) -> bool {
+    is_simplerouter_provider_id(provider_id)
+        && std::env::var(DISABLE_TOKEN_RATE_ENV)
+            .map(|value| value.trim().is_empty())
+            .unwrap_or(true)
+}
+
+fn rate(output_tokens: f64, duration: Duration) -> Option<f64> {
+    let seconds = duration.as_secs_f64();
+    (output_tokens > 0.0 && seconds > 0.0).then_some(output_tokens / seconds)
+}
+
+impl ChatWidget {
+    pub(super) fn on_generation_rate_sampling_started(&mut self, active_api_duration_ms: i64) {
+        self.generation_rate
+            .sampling_started(active_api_duration_ms, Instant::now());
+        self.refresh_status_line();
+    }
+
+    pub(super) fn on_generation_rate_delta(&mut self, delta: &str) {
+        self.generation_rate.observe_delta(delta, Instant::now());
+        self.refresh_status_line();
+    }
+
+    pub(super) fn on_generation_rate_response_completed(&mut self, output_tokens: Option<i64>) {
+        self.generation_rate.response_completed(output_tokens);
+        self.refresh_status_line();
+    }
+
+    pub(super) fn on_generation_rate_sampling_stopped(
+        &mut self,
+        active_api_duration_ms: i64,
+        generation_duration_ms: Option<i64>,
+        streamed_output_chars: i64,
+    ) {
+        self.generation_rate.sampling_stopped(
+            active_api_duration_ms,
+            generation_duration_ms,
+            streamed_output_chars,
+            Instant::now(),
+        );
+        self.refresh_status_line();
+    }
+}
+
+#[cfg(test)]
+#[path = "generation_rate_tests.rs"]
+mod tests;
